---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Services — SR Soft LLC"
  description="SR Soft services — SAP, AI, data engineering, pharma, cloud, and management consulting."
  current="services"
>
<!-- ========================================================
     HERO — outcome-led, with dotted SCREW figure
     Mirrors the careers head pattern (head-main + figure).
     ======================================================== -->
<section class="services-v2-head" data-screen-label="01 Hero">
  <div class="container">
    <div class="services-v2-head-grid">
      <div class="services-v2-head-main">
        <div class="editorial-rule">
          <span>Services at SR Soft</span>
        </div>
        <h1 class="services-v2-headline">What stays <em>running</em><br>after we leave.</h1>
        <p class="services-v2-lead">Six practices, one bar. Every engagement is judged by what the client owns and operates a year after handoff — not the slide deck, the change orders, or the consultant-hours logged.</p>
        <div class="careers-v2-actions">
          <a href="#outcomes" class="btn btn-outline">See outcomes at a glance</a>
          <a href="/contact" class="btn-pill" aria-label="Schedule a consultation with SR Soft">
            <span>Schedule a consultation</span>
            <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="services-v2-meta">
          <span><strong>20+ yrs</strong> inside SAP</span>
          <span><strong>6</strong> practices</span>
          <span><strong>1</strong> bar, production-grade</span>
        </div>
      </div>

      <figure class="head-figure-gear">
        <canvas id="services-gear" width="520" height="520" aria-hidden="true"></canvas>
        <div class="head-fig-tags">
          <span class="pill">Built to keep running</span>
        </div>
      </figure>
    </div>
  </div>
</section>

<!-- ========================================================
     OUTCOMES AT-A-GLANCE
     ======================================================== -->
<section class="sv-outcomes" id="outcomes" aria-label="Outcomes at a glance">
  <div class="container">
    <div class="sv-outcomes-head">
      <p class="eyebrow">Outcomes at a glance</p>
      <p class="note">Jump to any practice ↓</p>
    </div>
    <ul class="sv-outcomes-list reveal reveal-stagger">
      <li><a href="#sap">
        <div class="sv-outcomes-head-row">
          <span class="sv-outcomes-num">01</span>
          <span class="sv-outcomes-arrow" aria-hidden="true">↘</span>
        </div>
        <span class="sv-outcomes-name">SAP &amp; Enterprise Applications</span>
        <span class="sv-outcomes-text">A modern SAP landscape that holds together under audit, under scale, and under the AI built on top of it.</span>
      </a></li>
      <li><a href="#ai">
        <div class="sv-outcomes-head-row">
          <span class="sv-outcomes-num">02</span>
          <span class="sv-outcomes-arrow" aria-hidden="true">↘</span>
        </div>
        <span class="sv-outcomes-name">Artificial Intelligence</span>
        <span class="sv-outcomes-text">AI that reaches production. Connected to where the work happens, governed for audit.</span>
      </a></li>
      <li><a href="#data">
        <div class="sv-outcomes-head-row">
          <span class="sv-outcomes-num">03</span>
          <span class="sv-outcomes-arrow" aria-hidden="true">↘</span>
        </div>
        <span class="sv-outcomes-name">Data Engineering</span>
        <span class="sv-outcomes-text">A data foundation where the next AI project is a question of design, not data quality.</span>
      </a></li>
      <li><a href="#cloud">
        <div class="sv-outcomes-head-row">
          <span class="sv-outcomes-num">04</span>
          <span class="sv-outcomes-arrow" aria-hidden="true">↘</span>
        </div>
        <span class="sv-outcomes-name">Cloud Services</span>
        <span class="sv-outcomes-text">Cloud that runs cheaper than the data center it replaced, with the controls audit and security actually require.</span>
      </a></li>
      <li><a href="#pharma">
        <div class="sv-outcomes-head-row">
          <span class="sv-outcomes-num">05</span>
          <span class="sv-outcomes-arrow" aria-hidden="true">↘</span>
        </div>
        <span class="sv-outcomes-name">Pharma &amp; Life Sciences</span>
        <span class="sv-outcomes-text">Validated systems that pass inspection, including the AI ones, with frameworks regulators recognize.</span>
      </a></li>
      <li><a href="#management">
        <div class="sv-outcomes-head-row">
          <span class="sv-outcomes-num">06</span>
          <span class="sv-outcomes-arrow" aria-hidden="true">↘</span>
        </div>
        <span class="sv-outcomes-name">Management Consulting</span>
        <span class="sv-outcomes-text">Strategy that finishes, because the firm that wrote it is the same one shipping it.</span>
      </a></li>
    </ul>
  </div>
</section>

<!-- ========================================================
     01 — SAP — TREATMENT A (BOLD HERO)
     ======================================================== -->
<section class="sv-bold" id="sap" data-screen-label="02 SAP">
  <span class="sv-bold-watermark" aria-hidden="true">01</span>
  <div class="container">
    <div class="sv-bold-head reveal">
      <h2>Twenty years inside SAP, <em>and counting.</em></h2>
      <span class="sv-num">01 / SAP &amp; Enterprise Applications</span>
    </div>

    <div class="sv-bold-outcome sv-pop">
      <span class="sv-bold-outcome-label">Business outcome</span>
      A modern SAP landscape that holds together under audit, under scale, and under the AI work going on top of it.
    </div>

    <div class="sv-bold-body reveal">
      <div class="col-meta">
        <div class="sv-bold-bestfor">
          <span class="sv-label">Best for</span>
          <p>Organizations running SAP at production scale, planning S/4HANA migration, BTP extension, or Joule deployment without a six-quarter detour.</p>
        </div>
        <div class="sv-bold-platforms">
          <span class="sv-label">Platforms</span>
          <p class="sv-platforms">SAP S/4HANA · SAP ECC · SAP BTP · ABAP Cloud · Joule · Fiori · Solution Manager · Oracle Fusion · Oracle EBS · Salesforce · Workday · PeopleSoft · Microsoft Dynamics 365</p>
        </div>
      </div>
      <div>
        <span class="sv-label" style="margin-bottom: var(--space-5);">What we deliver</span>
        <ul class="sv-deliver-list reveal-stagger">
          <li>S/4HANA greenfield implementations and brownfield migrations</li>
          <li>SAP BTP architecture, extensions, and integration suite</li>
          <li>ABAP Cloud development and on-stack extensibility</li>
          <li>Joule deployment, configuration, and custom skill development</li>
          <li>Oracle Fusion, Salesforce, Workday, and PeopleSoft delivery</li>
          <li>Cross-platform integration architecture and middleware</li>
          <li>User training, change management, and adoption programs</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================
     02 — AI — TREATMENT B (CARD QUADRANT)
     ======================================================== -->
<section class="sv-cards" id="ai" data-screen-label="03 AI">
  <div class="container">
    <div class="sv-cards-head reveal">
      <h2>AI on top of the systems <em>that run the enterprise.</em></h2>
      <span class="sv-num">02 / Artificial Intelligence</span>
    </div>

    <div class="sv-cards-grid reveal reveal-stagger">
      <div class="card-bestfor">
        <span class="sv-label">Best for</span>
        <p>Enterprises with real ERP data and a backlog of AI ideas that keep dying in pilot. Teams that need models connected to SAP, Oracle, or Salesforce, not isolated demos.</p>
      </div>
      <div class="card-outcome">
        <span class="sv-label">Business outcome</span>
        <p>AI that reaches production. Connected to where the work happens, governed for audit.</p>
      </div>
      <div class="card-deliver">
        <span class="sv-label">What we deliver</span>
        <ul>
          <li>SAP BTP AI services and Joule custom skill development</li>
          <li>RAG systems over SAP, SharePoint, and document repositories</li>
          <li>Autonomous and semi-autonomous agent workflows</li>
          <li>Custom LLM applications and chat interfaces</li>
          <li>Model evaluation, fine-tuning, and prompt engineering</li>
          <li>AI governance frameworks and audit trails</li>
        </ul>
      </div>
      <div class="card-platforms">
        <span class="sv-label">Platforms</span>
        <p>SAP BTP AI Core · Joule · OpenAI · Anthropic · Hugging Face · LangChain · LlamaIndex · Databricks · Python · Vector DBs (Pinecone, Weaviate, pgvector)</p>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================
     03 — DATA — TREATMENT C (DARK EDITORIAL)
     ======================================================== -->
<section class="sv-editorial" id="data" data-screen-label="04 Data">
  <div class="container">
    <div class="sv-editorial-head reveal">
      <span class="sv-num">03 / Data Engineering</span>
      <h2>The foundation work that makes <em>everything else</em> possible.</h2>
    </div>

    <div class="sv-editorial-pull reveal">
      <span class="sv-label">Business outcome</span>
      <blockquote>A data foundation where the next AI project is a question of design, not data quality.</blockquote>
    </div>

    <div class="sv-editorial-cols reveal reveal-stagger">
      <div class="col">
        <h4>Best for</h4>
        <p>Teams whose AI and BI investments stall because the data underneath was never built right. Most AI projects fail there. That&rsquo;s where we start.</p>
      </div>
      <div class="col">
        <h4>What we deliver</h4>
        <ul>
          <li>SAP Datasphere and BW/4HANA modeling, migration, extension</li>
          <li>Cloud DW design &amp; migration (Snowflake, Databricks, BigQuery)</li>
          <li>ETL/ELT pipelines and real-time streaming architectures</li>
          <li>Master data management and data governance frameworks</li>
          <li>Self-service BI and analytics enablement</li>
          <li>Data quality, observability, and lineage tooling</li>
          <li>AI/ML feature stores and training data pipelines</li>
        </ul>
      </div>
      <div class="col">
        <h4>Platforms</h4>
        <p class="platforms-text">SAP Datasphere · BW/4HANA · Snowflake · Databricks · dbt · Apache Airflow · Fivetran · Tableau · Power BI · Looker · Kafka · AWS Glue</p>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================
     04 — CLOUD — TREATMENT D (TIGHT / SIMPLE)
     ======================================================== -->
<section class="sv-tight" id="cloud" data-screen-label="05 Cloud">
  <div class="container">
    <div class="sv-tight-grid">
      <div class="col-left reveal">
        <span class="sv-num">04 / Cloud Services</span>
        <h2>Migration and modernization for enterprise IT, <em>not greenfield.</em></h2>
        <div class="sv-tight-outcome">
          <span class="sv-tight-outcome-label">Business outcome</span>
          Cloud that runs cheaper than the data center it replaced, with the controls audit and security actually require.
        </div>
        <div class="sv-tight-bestfor">
          <span class="sv-label">Best for</span>
          <p>Enterprise IT moving SAP and adjacent workloads to AWS, Azure, or GCP under hybrid, regulated, brownfield constraints. The conditions most cloud guidance ignores.</p>
        </div>
      </div>
      <div class="col-right reveal">
        <div>
          <span class="sv-label">What we deliver</span>
          <ul class="sv-deliver-list reveal-stagger">
            <li>Cloud strategy, architecture, and target operating models</li>
            <li>RISE with SAP and SAP on hyperscaler architecture</li>
            <li>AWS, Azure, and GCP migrations and modernization</li>
            <li>Hybrid and multi-cloud architecture</li>
            <li>Kubernetes and container platform implementation</li>
            <li>Infrastructure-as-code and DevOps enablement</li>
            <li>Security, compliance, and identity management</li>
            <li>FinOps and cloud cost optimization programs</li>
          </ul>
        </div>
        <div>
          <span class="sv-label">Platforms</span>
          <p class="sv-platforms">AWS · Azure · GCP · RISE with SAP · Kubernetes · Terraform · Ansible · Docker · GitLab CI · GitHub Actions</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================
     05 — PHARMA — TREATMENT A v2 (BOLD HERO)
     ======================================================== -->
<section class="sv-bold" id="pharma" data-screen-label="06 Pharma">
  <span class="sv-bold-watermark" aria-hidden="true">05</span>
  <div class="container">
    <div class="sv-bold-head reveal">
      <h2>Regulated work, done <em>the way regulators expect.</em></h2>
      <span class="sv-num">05 / Pharma &amp; Life Sciences</span>
    </div>

    <div class="sv-bold-outcome sv-pop">
      <span class="sv-bold-outcome-label">Business outcome</span>
      Validated systems that pass inspection, including the AI ones, with frameworks regulators recognize.
    </div>

    <div class="sv-bold-body reveal">
      <div class="col-meta">
        <div class="sv-bold-bestfor">
          <span class="sv-label">Best for</span>
          <p>Pharma, biotech, and medical-device companies running validated systems under FDA scrutiny, plus those bringing AI/ML into regulated workflows where every model still has to validate.</p>
        </div>
        <div class="sv-bold-platforms">
          <span class="sv-label">Frameworks</span>
          <p class="sv-platforms">GxP · GAMP 5 · 21 CFR Part 11 · ICH guidelines · FDA Computer Software Assurance (CSA) · ISO 13485</p>
        </div>
      </div>
      <div>
        <span class="sv-label" style="margin-bottom: var(--space-5);">What we deliver</span>
        <ul class="sv-deliver-list reveal-stagger">
          <li>Computer System Validation (CSV) and GAMP 5 compliance</li>
          <li>21 CFR Part 11 electronic records and signatures</li>
          <li>IQ/OQ/PQ protocols and execution</li>
          <li>Clinical data management and EDC system support</li>
          <li>Quality management system (QMS) implementation</li>
          <li>FDA audit preparation and remediation</li>
          <li>AI/ML validation frameworks for regulated environments</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================
     06 — MANAGEMENT — TREATMENT B v2 (CARD QUADRANT)
     ======================================================== -->
<section class="sv-cards" id="management" data-screen-label="07 Management">
  <div class="container">
    <div class="sv-cards-head reveal">
      <h2>Strategy that <em>survives contact</em> with delivery.</h2>
      <span class="sv-num">06 / Management Consulting</span>
    </div>

    <div class="sv-cards-grid reveal reveal-stagger">
      <div class="card-bestfor">
        <span class="sv-label">Best for</span>
        <p>Leadership teams where the strategy deck and the implementation team have never met, and the gap between them is starting to show up in the program plan.</p>
      </div>
      <div class="card-outcome">
        <span class="sv-label">Business outcome</span>
        <p>Strategy that finishes, because the firm that wrote it is the same one shipping it.</p>
      </div>
      <div class="card-deliver">
        <span class="sv-label">What we deliver</span>
        <ul>
          <li>Digital transformation strategy and roadmaps</li>
          <li>Business process design and re-engineering</li>
          <li>Operating model redesign and organizational change</li>
          <li>Program management and PMO setup</li>
          <li>Vendor selection and RFP support</li>
          <li>Post-merger IT integration</li>
          <li>Executive advisory and board-level reporting</li>
        </ul>
      </div>
      <div class="card-platforms">
        <span class="sv-label">Frameworks</span>
        <p>Lean · Six Sigma · Agile · SAFe · ITIL · TOGAF · Prosci change management</p>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================
     FINAL CTA
     ======================================================== -->
<section class="final-cta">
  <div class="container">
    <h2>Have a project in mind? <em>Let's talk through it.</em></h2>
    <p>Thirty-minute call. We'll listen, ask hard questions, and tell you honestly whether we can help.</p>
    <a href="/contact" class="btn btn-primary">Schedule a consultation <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
  </div>
</section>
</BaseLayout>
