<!-- ============================================================
     FINAL CTA V2
     ============================================================ -->
<section class="final-cta-v2" data-screen-label="06 CTA">
  <div class="container reveal">
    <div class="final-cta-v2-grid">
      <h2>Ready for a<br>career <em>conversation?</em></h2>
      <div class="cta-side">
        <p>Free 1:1 consultation. We'll help you figure out the right next step — whether or not it's training with us.</p>
        <a href="/contact" class="btn btn-primary" style="align-self:flex-start;">Schedule a consultation <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <div class="contact-row">
          <span>or email</span>
          <a href="mailto:careers@srsoftllc.com">careers@srsoftllc.com</a>
